# ======================
# WHITELIST - ONLY THESE GET COMMITTED
# ======================

# Whitelist essential config files that don't contain secrets
!.gitignore
!SOUL.md
!config.yaml
!scripts/
!skills/
!agentmail/
!bin/
!lib/
!LICENSE*
!README*
!CHANGELOG*
!CONTRIBUTING*
!docs/
!examples/
!templates/
!webui-mvp/

# But exclude anything in whitelisted dirs that matches secrets above
scripts/**/*key*
scripts/**/*secret*
scripts/**/*token*
skills/**/*key*
skills/**/*secret*
skills/**/*token*
agentmail/**/*key*
agentmail/**/*secret*
agentmail/**/*token*
bin/**/*key*
bin/**/*secret*
bin/**/*token*
lib/**/*key*
lib/**/*secret*
lib/**/*token*

